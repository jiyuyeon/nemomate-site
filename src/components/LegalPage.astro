---
// 약관·개인정보처리방침 공용 틀 — 본문은 slot으로 받는다.
interface Props { title: string; updated: string; }
const { title, updated } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="legal">
  <div class="container-narrow legal-inner">
    <a href={`${BASE}/`} class="legal-back">← 네모메이트 홈</a>
    <h1 class="legal-title">{title}</h1>
    <p class="legal-updated">시행일 {updated}</p>
    <div class="legal-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .legal { padding: 140px 0 96px; }
  .legal-inner { max-width: 760px; margin: 0 auto; }
  .legal-back { font-size: var(--font-label); color: var(--text-secondary); }
  .legal-title { margin: 16px 0 4px; font-size: 32px; color: var(--brown-900); }
  .legal-updated { margin: 0 0 32px; font-size: var(--font-label); color: var(--text-secondary); }
  .legal-body { font-size: var(--font-body); line-height: 1.75; color: var(--text-primary); word-break: keep-all; }
  .legal-body :global(h2) { margin: 36px 0 10px; font-size: 20px; color: var(--brown-900); }
  .legal-body :global(p) { margin: 0 0 12px; }
  .legal-body :global(ul), .legal-body :global(ol) { margin: 0 0 12px; padding-left: 22px; }
  .legal-body :global(li) { margin-bottom: 4px; }
  .legal-body :global(table) { width: 100%; border-collapse: collapse; margin: 8px 0 16px; font-size: var(--font-label); }
  .legal-body :global(th), .legal-body :global(td) { border: 1px solid var(--border); padding: 8px 10px; text-align: left; vertical-align: top; }
  .legal-body :global(th) { background: var(--bg-elevated); }
  .legal-body :global(.placeholder) { background: var(--accent-bg); padding: 0 4px; border-radius: 4px; }
  @media (max-width: 767px) {
    .legal { padding: 110px 0 64px; }
    .legal-title { font-size: 26px; }
    .legal-body :global(table) { display: block; overflow-x: auto; }
  }
</style>
