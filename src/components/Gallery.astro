---
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const screenshots = [
  { src: `${BASE}/screenshots/main.png`, alt: '게임 메인 화면' },
  { src: `${BASE}/screenshots/draw.png`, alt: '캐릭터 그리기' },
  { src: `${BASE}/screenshots/gacha.png`, alt: '가챠 뽑기' },
  { src: `${BASE}/screenshots/decorate.png`, alt: '꾸미기 모드' },
  { src: `${BASE}/screenshots/runner.png`, alt: '러너 게임' },
  { src: `${BASE}/screenshots/market.png`, alt: '마켓 화면' },
];
---

<section class="section section-alt" id="gallery">
  <div class="container">
    <h2 class="section-title reveal">미리보기</h2>
    <p class="section-subtitle reveal">네모와의 일상을 먼저 만나보세요</p>
  </div>

  <div class="gallery-wrapper">
    <div class="gallery-track reveal-stagger">
      {screenshots.map(s => (
        <div class="gallery-item reveal">
          <img class="gallery-shot" src={s.src} alt={s.alt} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* full-bleed 스크롤 */
  .gallery-wrapper {
    overflow-x: auto;
    /* overflow-x만 지정하면 세로축은 CSS 규칙상 auto가 되어 세로 스크롤이 생긴다.
       가로로만 넘겨야 하므로 세로는 명시적으로 잠근다. */
    overflow-y: hidden;
    /* 스크롤바 감추기 (파이어폭스 / 구형 엣지) */
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    padding: 0 var(--pad-desktop);
  }

  .gallery-track {
    display: flex;
    gap: 20px;
    /* 위아래 여백은 hover 확대(1.04배)와 그림자가 잘리지 않을 만큼 준다.
       세로 스크롤을 막았으므로 넘치는 부분은 그대로 잘린다. */
    padding: 14px 0 18px;
    scroll-snap-type: x mandatory;
  }

  .gallery-item {
    flex: 0 0 auto;
    /* 게임 창이 정사각형에 가까워(480x460) 세로로 긴 카드보다 이 폭이 맞는다 */
    width: 300px;
    /* 세로도 고정한다. 화면마다 창 높이가 달라 그대로 두면 카드가 들쭉날쭉해지고,
       가장 긴 화면(꾸미기 모드)에 맞춰 섹션이 쓸데없이 길어진다. */
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    border-radius: 18px;
    border: 2px solid var(--border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    scroll-snap-align: center;
    transition: transform var(--dur-smooth) var(--ease-smooth),
                box-shadow var(--dur-smooth) var(--ease-smooth);
  }

  .gallery-item:hover {
    transform: scale(1.04);
    box-shadow: var(--shadow-lg);
  }

  /* 카드 안에 꽉 차되 잘리지 않게. 부모가 flex 가운데 정렬이라 자동으로 중앙에 온다. */
  .gallery-shot {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  /* 스크롤바는 감춘다. 가로로 넘기는 건 그대로 되고 막대만 안 보인다. */
  .gallery-wrapper::-webkit-scrollbar { display: none; }

  @media (max-width: 767px) {
    .gallery-wrapper { padding: 0 var(--pad-mobile); }
    /* 300px 고정 카드는 320px 폰(안쪽 288px)보다 커서 화면 폭에 맞춰 줄인다 */
    .gallery-item {
      width: min(300px, calc(100vw - 32px));
      height: auto;
      aspect-ratio: 1;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .gallery-wrapper { padding: 0 var(--pad-tablet); }
  }
</style>
